#!/usr/bin/env python3
"""koji-duet-synthesize: merge Claude + codex findings into a verdict JSON.

Inputs: two JSON files (one per reviewer), each a list of finding objects
matching the schema in references/reviewer-prompt.md.

Optional second-pass inputs:
  --claude-cross  Claude's verdicts on codex's solo findings (cross-review)
  --codex-cross   codex's verdicts on Claude's solo findings (cross-review)
  --cross-review-done  Mark the verdict as final (no more cross-review passes)

Output: a single verdict JSON written to --out, with the schema in
references/verdict-format.md.

The exit code matches the verdict's exit_code field (0/1/2). This lets
callers (e.g., /duet-impl) gate on the process exit directly.

Consensus model:
  * First-pass consensus is EXACT-fingerprint only. When both reviewers
    independently emit the identical fingerprint (file:line:category) —
    which reviewer-prompt.md instructs them to do for the same bug — the two
    findings merge into ONE consensus entry (agreed_by=["claude","codex"],
    severity = max of the two). There is NO fuzzy ±line / category-family
    matching; coordinate coincidence never auto-merges.
  * A fingerprint exclusive to one reviewer stays SOLO. A solo HIGH is
    CONTESTED until the other reviewer AGREE-*s it via cross-review.
  * Consensus can also be reached in the second pass via explicit
    cross-review AGREE-* (see Cross-review logic).
  * After all buckets are populated, a global dedup keyed on fingerprint
    enforces precedence high_consensus > high_contested > medium > low, so a
    fingerprint never appears in two buckets at once.

Cross-review logic:
  * First-pass: writes cross_review_required=true if ANY reviewer-exclusive
    finding has severity >= medium (lows skip — not a style committee).
  * Second-pass (--*-cross + --cross-review-done): reprocesses solo findings
    using the other reviewer's labels. AGREE-HIGH/MEDIUM/LOW promote to
    consensus at that severity; DISAGREE / NEEDS-MORE-CONTEXT stay solo.
  * /duet-review Steps 5/6 must refuse if cross_review_required && !done.
"""
import argparse
import json
import sys
from pathlib import Path

SEV_RANK = {"high": 3, "medium": 2, "low": 1}


def load_findings(path: str) -> list:
    """Load a reviewer's findings; return [] on any parse error.

    Errors are logged to stderr but never fatal — a reviewer that emits
    malformed JSON should not block the whole pass.
    """
    try:
        text = Path(path).read_text()
    except FileNotFoundError:
        print(f"WARN: {path} not found, treating as empty", file=sys.stderr)
        return []
    try:
        data = json.loads(text)
    except json.JSONDecodeError as e:
        print(f"WARN: {path} not valid JSON ({e}); treating as empty", file=sys.stderr)
        return []
    if not isinstance(data, list):
        print(f"WARN: {path} top-level is not a list; treating as empty", file=sys.stderr)
        return []
    out = []
    for entry in data:
        if isinstance(entry, dict) and "severity" in entry and "category" in entry:
            out.append(entry)
    return out


def fingerprint(f: dict) -> str:
    return f"{f.get('file', '')}:{f.get('line', '')}:{f.get('category', '')}"


def _max_sev(a: str, b: str) -> str:
    """Return whichever of two severity strings ranks higher by SEV_RANK."""
    return a if SEV_RANK.get(a, 0) >= SEV_RANK.get(b, 0) else b


def first_pass_consensus(claude: list, codex: list) -> tuple:
    """Exact-fingerprint first-pass merge across the two reviewers.

    A fingerprint emitted by BOTH reviewers (reviewer-prompt.md tells them to
    canonicalize the same bug to the same fingerprint) collapses to ONE
    consensus entry: agreed_by=["claude","codex"], severity = max(SEV_RANK) of
    the two, with both per-reviewer severities recorded. A fingerprint
    exclusive to one reviewer stays solo for that reviewer.

    This is the ONLY automatic first-pass merge — exact fingerprint, no fuzzy
    ±line / category-family matching (that coincidence-prone path was removed
    in the Fork-C rewrite and is intentionally not reintroduced).

    Returns (consensus, claude_solo, codex_solo). Order within each list
    follows first appearance in the claude-then-codex scan, so output is
    deterministic. Duplicate fingerprints WITHIN one reviewer's list also
    collapse (highest severity wins) so a self-duplicate can't double-count.
    """
    # Index codex findings by fingerprint (last write wins on intra-reviewer
    # dup, but we fold severity so the kept entry carries the max severity).
    codex_by_fp: dict = {}
    for f in codex:
        fp = fingerprint(f)
        if fp in codex_by_fp:
            codex_by_fp[fp]["severity"] = _max_sev(
                codex_by_fp[fp].get("severity", "low"), f.get("severity", "low"))
        else:
            codex_by_fp[fp] = dict(f)

    consensus: list = []
    claude_solo: list = []
    claude_seen: set = set()
    matched_codex_fps: set = set()
    for cf in claude:
        fp = fingerprint(cf)
        if fp in claude_seen:
            # Intra-claude duplicate: fold severity into the already-emitted
            # entry (consensus or solo) rather than emitting a second copy.
            target = next((e for e in consensus + claude_solo
                           if fingerprint(e) == fp), None)
            if target is not None:
                target["severity"] = _max_sev(
                    target.get("severity", "low"), cf.get("severity", "low"))
            continue
        claude_seen.add(fp)
        xf = codex_by_fp.get(fp)
        if xf is not None:
            matched_codex_fps.add(fp)
            sev_c = cf.get("severity", "low")
            sev_x = xf.get("severity", "low")
            merged = dict(cf)
            merged["severity"] = _max_sev(sev_c, sev_x)
            merged["agreed_by"] = ["claude", "codex"]
            merged["claude_severity"] = sev_c
            merged["codex_severity"] = sev_x
            consensus.append(merged)
        else:
            claude_solo.append(dict(cf))

    codex_solo: list = []
    for fp, xf in codex_by_fp.items():
        if fp not in matched_codex_fps:
            codex_solo.append(dict(xf))

    return consensus, claude_solo, codex_solo


def dedup_buckets(buckets: list) -> None:
    """Global cross-bucket dedup by fingerprint, IN PLACE.

    `buckets` is an ordered list of (name, list) by descending precedence
    (high_consensus > high_contested > medium > low). The first occurrence of
    a fingerprint wins; every later occurrence — in this or a lower bucket —
    is evicted. This collapses the post-cross-review case where a finding sits
    in high_consensus AND in a lower contested/medium/low bucket, and also
    absorbs any residual intra-bucket duplicate.
    """
    seen: set = set()
    for _name, bucket in buckets:
        kept = []
        for f in bucket:
            fp = fingerprint(f)
            if fp in seen:
                continue
            seen.add(fp)
            kept.append(f)
        bucket[:] = kept


def load_cross_review(path: str) -> dict:
    """Load a cross-review response file. Returns {fingerprint: verdict_label}.

    Expected shape: a JSON array of {"fingerprint": "...", "verdict": "AGREE-HIGH"
    | "AGREE-MEDIUM" | "AGREE-LOW" | "DISAGREE" | "NEEDS-MORE-CONTEXT", ...}.
    Malformed entries are silently dropped (cross-review failure shouldn't
    block the whole pass; the original solo findings just stay solo).
    """
    if not path:
        return {}
    try:
        data = json.loads(Path(path).read_text())
    except (FileNotFoundError, json.JSONDecodeError) as e:
        print(f"WARN: {path} not loadable ({e}); cross-review ignored",
              file=sys.stderr)
        return {}
    if not isinstance(data, list):
        return {}
    out = {}
    for entry in data:
        if not isinstance(entry, dict):
            continue
        fp = entry.get("fingerprint", "")
        v = entry.get("verdict", "")
        if fp and v in ("AGREE-HIGH", "AGREE-MEDIUM", "AGREE-LOW",
                        "DISAGREE", "NEEDS-MORE-CONTEXT"):
            out[fp] = v
    return out


# Maps a cross-review AGREE-* label to the severity it implies.
CROSS_AGREE_SEV = {
    "AGREE-HIGH": "high",
    "AGREE-MEDIUM": "medium",
    "AGREE-LOW": "low",
}


def apply_cross_review(solo_findings: list, other_responses: dict,
                       other_reviewer: str) -> tuple:
    """Walk solo findings; promote any that the other reviewer AGREE-*'d.

    Returns (promoted_pairs, still_solo). promoted_pairs is a list of
    (finding, agreed_severity) tuples; still_solo retains its original
    severity and agreed_by.
    """
    promoted = []
    still_solo = []
    for f in solo_findings:
        fp = fingerprint(f)
        verdict = other_responses.get(fp, "")
        if verdict in CROSS_AGREE_SEV:
            agreed_sev = CROSS_AGREE_SEV[verdict]
            f2 = dict(f)
            # Always use the cross-reviewer's severity (AGREE-* is authoritative).
            # AGREE-HIGH escalates an original LOW finding to HIGH; AGREE-LOW
            # de-escalates an original HIGH to LOW (both reviewers now agree
            # at the lower bar — the more conservative ship signal).
            original_sev = f.get("severity", "low")
            sev = agreed_sev
            f2["severity"] = sev
            f2["agreed_by"] = sorted({"claude", "codex"})
            f2["claude_severity"] = original_sev if other_reviewer == "codex" \
                else agreed_sev
            f2["codex_severity"] = agreed_sev if other_reviewer == "codex" \
                else original_sev
            f2["cross_review"] = {"by": other_reviewer, "verdict": verdict}
            promoted.append(f2)
        else:
            f2 = dict(f)
            if verdict:
                f2["cross_review"] = {"by": other_reviewer, "verdict": verdict}
            still_solo.append(f2)
    return promoted, still_solo


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--claude", required=True)
    ap.add_argument("--codex", required=True)
    ap.add_argument("--out", required=True)
    ap.add_argument("--base", default="")
    ap.add_argument("--head", default="")
    ap.add_argument("--claude-cross", default="",
                    help="Claude's verdicts on codex's solo findings")
    ap.add_argument("--codex-cross", default="",
                    help="codex's verdicts on Claude's solo findings")
    ap.add_argument("--cross-review-done", action="store_true",
                    help="Mark this verdict as cross-review-final")
    args = ap.parse_args()

    claude = load_findings(args.claude)
    codex = load_findings(args.codex)

    # First-pass EXACT-fingerprint consensus: a fingerprint emitted by BOTH
    # reviewers merges to one consensus entry now; the rest stay solo per
    # reviewer and still need (or already received) cross-review.
    first_pass_agreed, claude_solo, codex_solo = first_pass_consensus(
        claude, codex)

    # Apply cross-review responses (if any were provided).
    codex_responses_to_claude = load_cross_review(args.codex_cross)
    claude_responses_to_codex = load_cross_review(args.claude_cross)

    claude_promoted, claude_still_solo = apply_cross_review(
        claude_solo, codex_responses_to_claude, "codex")
    codex_promoted, codex_still_solo = apply_cross_review(
        codex_solo, claude_responses_to_codex, "claude")

    high_consensus: list = []
    high_contested: list = []
    medium: list = []
    low: list = []

    def consensus_bucket(sev: str) -> list:
        return {"high": high_consensus, "medium": medium, "low": low}.get(
            sev, low)

    def contested_bucket(sev: str) -> list:
        return {"high": high_contested, "medium": medium, "low": low}.get(
            sev, low)

    # 1. First-pass exact-fingerprint consensus (both reviewers, same bug).
    #    A consensus HIGH routes to high_consensus -> REJECT.
    for f in first_pass_agreed:
        consensus_bucket(f.get("severity", "low")).append(f)

    # 2. Cross-review promoted findings (consensus via AGREE-*).
    for f in claude_promoted + codex_promoted:
        consensus_bucket(f.get("severity", "low")).append(f)

    # 3. Still-solo findings (a solo HIGH is CONTESTED, not consensus).
    for f in claude_still_solo:
        f["agreed_by"] = ["claude"]
        contested_bucket(f.get("severity", "low")).append(f)
    for f in codex_still_solo:
        f["agreed_by"] = ["codex"]
        contested_bucket(f.get("severity", "low")).append(f)

    # 4. Global cross-bucket dedup. Precedence high_consensus > high_contested
    #    > medium > low: a fingerprint promoted to consensus evicts its twin
    #    from every lower bucket, so the same bug is never double-listed and
    #    Step 5 auto-apply never races a phantom contested entry. Run BEFORE
    #    totals/verdict so both reflect the deduped buckets.
    dedup_buckets([
        ("high_consensus", high_consensus),
        ("high_contested", high_contested),
        ("medium", medium),
        ("low", low),
    ])

    if high_consensus:
        verdict, exit_code = "REJECT", 1
    elif high_contested:
        verdict, exit_code = "CONTESTED", 2
    elif medium or low:
        verdict, exit_code = "PASS-WITH-NOTES", 0
    else:
        verdict, exit_code = "PASS", 0

    # cross_review_required: any reviewer-exclusive finding at severity >= medium
    # would benefit from a second-opinion pass. Lows skip ("not a style
    # committee"). After the second pass (--cross-review-done), the flag is
    # forced to whatever resulted from the second pass (could still be true if
    # disagreement persists, but cross_review_done = true tells downstream
    # there are no more rounds to run).
    remaining_solo_actionable = sum(
        1 for f in claude_still_solo + codex_still_solo
        if f.get("severity") in ("high", "medium"))
    cross_review_required = remaining_solo_actionable > 0
    cross_review_done = bool(args.cross_review_done)

    out = {
        "verdict": verdict,
        "base": args.base,
        "head": args.head,
        "reviewers": ["claude", "codex"],
        "cross_review_required": cross_review_required,
        "cross_review_done": cross_review_done,
        "totals": {
            "high_consensus": len(high_consensus),
            "high_contested": len(high_contested),
            "medium": len(medium),
            "low": len(low),
        },
        "high_consensus": high_consensus,
        "high_contested": high_contested,
        "medium": medium,
        "low": low,
        "auto_applied": [],
        "user_held": [],
        "reported_only": [],
        "exit_code": exit_code,
    }

    Path(args.out).write_text(json.dumps(out, indent=2))
    # PRELIMINARY suffix on first-pass when cross-review is required but not
    # yet done — strong cognitive signal to the orchestrator (in any session,
    # not just this one) that the verdict is not final. After --cross-review-done
    # the suffix drops. Combined with the Step 5/6 hard gate, this is the
    # cross-session enforcement layer that prevents "skipped Step 4" silent ships.
    if cross_review_required and not cross_review_done:
        print(f"{verdict}-PRELIMINARY")
    else:
        print(verdict)
    return exit_code


if __name__ == "__main__":
    sys.exit(main())
