#!/usr/bin/env bash
# koji-selfcheck — static drift-lint for a skill's load-bearing markers.
#
#   koji-selfcheck [skill-name]      (no arg: check every skill with markers)
#
# Asserts that a koji skill's SKILL.md still contains the verbatim prose markers
# that encode its contract. This is a static lint (fixed-string grep), NOT a
# behavioral test: if an edit guts a marker — removes the round cap, softens the
# triage rule, drops the gstack-override note — it fails LOUD instead of letting
# the skill silently drift. Wired into `setup` so a degraded skill cannot install
# quietly.
#
# A no-arg run checks every skill listed in ALL_WITH_MARKERS below — the single
# source of truth `setup` relies on. Each contract here regressed at least once
# while it lived as loose prose (plan-triangulate-review's autonomous loop; the
# duet cross-review gate), so the markers exist precisely so that can't recur.
# Exit 0 if all present; exit 1 listing each missing one.

set -euo pipefail

KOJI_DIR="$(cd "$(dirname "$0")/.." && pwd)"

# Skills that carry load-bearing markers (defined in the case below). A no-arg
# run checks them ALL; adding a newly-pinned skill here is all it takes to wire
# it into install-time lint (setup calls this script with no argument).
ALL_WITH_MARKERS=(plan-triangulate-review duet-review duet-impl)

if [ -z "${1:-}" ]; then
  rc=0
  for s in "${ALL_WITH_MARKERS[@]}"; do
    "$0" "$s" || rc=1
  done
  exit "$rc"
fi

SKILL="$1"
FILE="$KOJI_DIR/$SKILL/SKILL.md"

if [ ! -f "$FILE" ]; then
  echo "koji-selfcheck: SKILL.md not found: $FILE" >&2
  exit 1
fi

# Load-bearing markers, per skill. Each MUST appear verbatim in the SKILL.md;
# they double as the human-readable contract and the lint target. Authoring a
# marker into the prose and asserting it here are two halves of one guard.
case "$SKILL" in
  plan-triangulate-review)
    MARKERS=(
      "consensus (both AGREE) auto-locks"
      "hard round cap = 3"
      "Debate is the exception, not the default"
      "Stream per finding"
      "substitutes ONE end-of-run ratification"
      "big-picture lens"
      "from finding #1"
      "nothing is written to the plan until you ratify"
    )
    ;;
  duet-review)
    MARKERS=(
      "before you assess, triage, or apply ANY finding"
      "There is no verdict without the synthesizer"
      "Fan-out priming trap"
      "codex quota is not zero findings"
    )
    ;;
  duet-impl)
    MARKERS=(
      "Verify the embedded review actually ran its cross-review"
      "caller-side structural backstop"
      "recorded deferral, not a blocking prompt"
      "quota reply is not an empty findings array"
    )
    ;;
  *)
    echo "koji-selfcheck: no markers defined for '$SKILL' — nothing to check."
    exit 0
    ;;
esac

MISSING=0
for m in "${MARKERS[@]}"; do
  if ! grep -qF -- "$m" "$FILE"; then
    echo "MISSING MARKER: $m"
    MISSING=1
  fi
done

if [ "$MISSING" = "1" ]; then
  echo "koji-selfcheck: $SKILL FAILED — load-bearing markers missing (see above)." >&2
  exit 1
fi
echo "koji-selfcheck: $SKILL OK (${#MARKERS[@]} markers present)"
exit 0
