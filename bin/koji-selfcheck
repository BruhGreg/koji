#!/usr/bin/env bash
# koji-selfcheck — static drift-lint for a skill's load-bearing markers.
#
#   koji-selfcheck [skill-name]      (no arg: check every skill with markers)
#
# Asserts that a koji skill's SKILL.md still contains the verbatim prose markers
# that encode its contract. This is a static lint (fixed-string grep), NOT a
# behavioral test: if an edit guts a marker — removes the round cap, softens the
# triage rule, drops the gstack-override note — it fails LOUD instead of letting
# the skill silently drift. Wired into `setup` so a degraded skill cannot install
# quietly.
#
# Two kinds of pin:
#   MARKERS  — must appear at least once (presence).
#   COUNTED  — (min-count, marker) pairs; the marker must appear at least
#              min-count times. Used for phrases that live at EVERY dispatch
#              site (e.g. the Claude-backend "Call the `Agent` tool" block), so
#              dropping one site fails even though the phrase still exists
#              elsewhere. Counted with `grep -oF | wc -l` (occurrences, not
#              lines — two sites on one line count twice).
#
# A no-arg run checks every skill listed in ALL_WITH_MARKERS below — the single
# source of truth `setup` relies on. Each contract here regressed at least once
# while it lived as loose prose (plan-triangulate-review's autonomous loop; the
# duet cross-review gate; duet-plan's consensus detection), so the markers exist
# precisely so that can't recur.
# Exit 0 if all present; exit 1 listing each missing one.

set -euo pipefail

KOJI_DIR="$(cd "$(dirname "$0")/.." && pwd)"

# Skills that carry load-bearing markers (defined in the case below). A no-arg
# run checks them ALL; adding a newly-pinned skill here is all it takes to wire
# it into install-time lint (setup calls this script with no argument).
ALL_WITH_MARKERS=(plan-triangulate-review duet-review duet-impl duet-plan triangulate)

if [ -z "${1:-}" ]; then
  rc=0
  for s in "${ALL_WITH_MARKERS[@]}"; do
    "$0" "$s" || rc=1
  done
  exit "$rc"
fi

SKILL="$1"
FILE="$KOJI_DIR/$SKILL/SKILL.md"

if [ ! -f "$FILE" ]; then
  echo "koji-selfcheck: SKILL.md not found: $FILE" >&2
  exit 1
fi

# Load-bearing markers, per skill. Each MUST appear verbatim in the SKILL.md;
# they double as the human-readable contract and the lint target. Authoring a
# marker into the prose and asserting it here are two halves of one guard.
COUNTED=()
case "$SKILL" in
  plan-triangulate-review)
    MARKERS=(
      "consensus (both AGREE) auto-locks"
      "hard round cap = 3"
      "Debate is the exception, not the default"
      "Stream per finding"
      "substitutes ONE end-of-run ratification"
      "big-picture lens"
      "from finding #1"
      "nothing is written to the plan until you ratify"
      "Never substitute a fresh-context Claude reviewer for it"
    )
    COUNTED=(
      1 'koji-codex-exec "$TIMEOUT" "$EFFORT" "$PROJECT_ROOT"'
      1 'exit 78'
      1 'exit 79'
      1 'koji-dispatch-abort'
    )
    ;;
  duet-review)
    MARKERS=(
      "before you assess, triage, or apply ANY finding"
      "There is no verdict without the synthesizer"
      "Fan-out priming trap"
      "codex quota is not zero findings"
      "Never substitute a fresh-context Claude reviewer for it"
    )
    # Reviewer-backend dispatch sites: 2b Reviewer A (single) + 2a Claude leg +
    # 4b Claude cross leg. The two Claude-backend sites carry the never-a-fork rule.
    COUNTED=(
      3 'Call the `Agent` tool'
      2 'fresh Agent context, never a fork'
      # Both codex dispatch sites (2a and the 4b cross leg) must route through
      # the wrapper AND carry the terminal-exit guard. Pin the full invocation,
      # not the bare program name: `koji-codex-exec` also appears in prose here,
      # so a count of 2 against the name alone would still pass after a real
      # dispatch site was deleted.
      2 'koji-codex-exec "$TIMEOUT" "$EFFORT" "$PROJECT_ROOT"'
      2 'exit 78 ;;'
      2 'exit 79 ;;'
      4 'koji-dispatch-abort'
    )
    ;;
  duet-impl)
    MARKERS=(
      "Verify the embedded review actually ran its cross-review"
      "caller-side structural backstop"
      "recorded deferral, not a blocking prompt"
      "a codex reply that is not a findings array is not a review"
      "Never substitute a fresh-context Claude reviewer for it"
      "claude+codex-confirm"
      "A slot file exists only when it holds a validated array"
    )
    # Literal call phrase: 2c Claude leg, both-mode cross leg, consult leg, 3a
    # promise auditor. Never-a-fork rule: the three reviewer legs (not the auditor).
    # Plus the codex dispatch shape and BOTH terminal arms — pinned by the full
    # invocation, not the bare program name, which also appears in prose.
    COUNTED=(
      4 'Call the `Agent` tool'
      3 'fresh Agent context, never a fork'
      1 'koji-codex-exec "$TIMEOUT" "$EFFORT" "$PROJECT_ROOT"'
      1 'exit 78 ;;'
      1 'exit 79 ;;'
      2 'koji-dispatch-abort'
    )
    ;;
  duet-plan)
    MARKERS=(
      "Never substitute a fresh-context Claude reviewer for it"
      "CONSENSUS REACHED at round"
      'rm "$CODEX_FILE"'
      "--prose"
      "exactly one codex call"
    )
    # 2a drafter + 2b Claude leg + 2d drafter.
    COUNTED=(
      3 'Call the `Agent` tool'
      1 'fresh Agent context, never a fork'
      1 'koji-codex-exec "$TIMEOUT" "$EFFORT" "$PROJECT_ROOT"'
      1 'exit 78 ;;'
      1 'exit 79 ;;'
      2 'koji-dispatch-abort'
    )
    ;;
  triangulate)
    MARKERS=(
      "Never substitute a fresh-context Claude reviewer for it"
      "restore the pair Step 1 resolved, never re-default it here"
    )
    COUNTED=(
      1 'koji-codex-exec "$TIMEOUT" "$EFFORT" "$PROJECT_ROOT"'
      1 'exit 78'
      2 'exit 79'
      1 'koji-dispatch-abort'
    )
    ;;

  *)
    echo "koji-selfcheck: no markers defined for '$SKILL' — nothing to check."
    exit 0
    ;;
esac

MISSING=0
for m in "${MARKERS[@]}"; do
  if ! grep -qF -- "$m" "$FILE"; then
    echo "MISSING MARKER: $m"
    MISSING=1
  fi
done

i=0
while [ "$i" -lt "${#COUNTED[@]}" ]; do
  want="${COUNTED[$i]}"
  m="${COUNTED[$((i+1))]}"
  have="$(grep -oF -- "$m" "$FILE" | wc -l | tr -d ' ')"
  if [ "$have" -lt "$want" ]; then
    echo "MISSING MARKER: '$m' — need >= $want occurrence(s), found $have"
    MISSING=1
  fi
  i=$((i+2))
done

if [ "$MISSING" = "1" ]; then
  echo "koji-selfcheck: $SKILL FAILED — load-bearing markers missing (see above)." >&2
  exit 1
fi
echo "koji-selfcheck: $SKILL OK (${#MARKERS[@]} markers, $(( ${#COUNTED[@]} / 2 )) counted present)"
exit 0
