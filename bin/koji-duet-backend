#!/usr/bin/env bash
# koji-duet-backend — resolve which model backs a duet role, from one table.
#
# Usage: koji-duet-backend <plan-round|impl-gate|review-b>
#
# Prints exactly one token on stdout: `codex` or `claude`. Nothing else — the
# caller is expected to use it inline (`backend=$(koji-duet-backend review-b)`).
# Exit 0 on success, 2 on usage error (missing or unknown context).
#
# The decision reads $DUET_REVIEWER (self-sources koji-detect when unset, the
# same idiom as koji-plans-research). Recognised values:
#
#   codex                       codex reviews everything          (default)
#   claude                      a second Claude reviews everything
#   claude-rounds+codex-final   Claude for the cheap iterative roles,
#                               codex for the final adversarial B-side
#
# The mapping below is the single source of truth for three skills
# (/duet-plan, /duet-impl, /duet-review). Do not re-derive it in SKILL.md — a
# second copy is a second thing to drift.
#
#   context     | codex | claude | claude-rounds+codex-final | anything else
#   ------------+-------+--------+---------------------------+--------------
#   plan-round  | codex | claude | claude                    | codex
#   impl-gate   | codex | claude | claude                    | codex
#   review-b    | codex | claude | codex                     | codex
#
# Matching is done with `case`, never a regex: the `+` in
# `claude-rounds+codex-final` is a literal character in a case glob but a
# repetition operator in ERE, so a regex port of this table silently
# mis-matches.
set -euo pipefail

CONTEXT="${1:-}"

if [ -z "${DUET_REVIEWER:-}" ]; then
  # koji-detect resolves duet.reviewer (and warns + falls back to codex on an
  # invalid config value). The `:-codex` fallback below still stands on its own
  # so this script answers even where koji-detect emits nothing for the key.
  eval "$(~/.claude/skills/koji/bin/koji-detect)"
fi

REVIEWER="${DUET_REVIEWER:-codex}"

_usage() {
  cat >&2 <<'USAGE'
koji-duet-backend — which model backs a duet role.

Usage: koji-duet-backend <context>

Contexts:
  plan-round   a /duet-plan dialogue round
  impl-gate    a /duet-impl foundation or post-foundation gate
  review-b     the B-side reviewer of /duet-review

Prints `codex` or `claude`. Reads $DUET_REVIEWER
(codex | claude | claude-rounds+codex-final; default codex).
USAGE
}

case "$CONTEXT" in
  plan-round|impl-gate)
    case "$REVIEWER" in
      claude|claude-rounds+codex-final) printf 'claude\n' ;;
      *)                                printf 'codex\n' ;;
    esac
    ;;
  review-b)
    case "$REVIEWER" in
      claude) printf 'claude\n' ;;
      *)      printf 'codex\n' ;;
    esac
    ;;
  "")
    printf 'ERROR: missing context argument\n' >&2
    _usage
    exit 2
    ;;
  *)
    printf 'ERROR: unknown context: %s\n' "$CONTEXT" >&2
    _usage
    exit 2
    ;;
esac
