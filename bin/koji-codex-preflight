#!/usr/bin/env bash
# koji-codex-preflight — renamed to koji-outside-preflight in koji 0.11.0.
#
# A forwarding shim, kept for one release: a session that loaded a SKILL.md
# before the update still names this helper, and an `exit 127` there would
# stop its run. Remove after 0.11.x.
case "$0" in */*) d="${0%/*}" ;; *) d=. ;; esac
exec "$d/koji-outside-preflight" "$@"
