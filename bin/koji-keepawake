#!/usr/bin/env bash
# koji-keepawake — opt-in sleep prevention for long, unattended koji skill runs.
#
# Used by /duet-plan, /duet-impl, and /triangulate (incl. its review-skill
# composition) to keep the machine awake while background AI dispatches run, so
# the user can walk away. Spawns `caffeinate -i` (Darwin) / `systemd-inhibit`
# (Linux) at the start of a run and tears it down at the end.
#
#   koji-keepawake start   — ensure the system stays awake; bump a refcount
#   koji-keepawake stop     — drop the refcount; tear down when it hits 0
#   koji-keepawake status   — report state (exit 0 if anything is keeping awake)
#
# Reference-counted on purpose: when /triangulate is invoked per-finding INSIDE
# a /plan-eng-review composition, the composition holds the outer `start` and
# each per-finding run nests (start->2, stop->1) — so the keep-awake never
# flaps off between findings; only the composition's final `stop` kills it.
#
# Ownership is tracked by the spawned PID in a state file. `stop` only ever
# kills a process THIS tool spawned — a caffeinate the user (or another tool)
# started is detected via `pgrep` and left strictly alone, never killed.
#
# `-t <backstop>` is a crash safety net: if a run dies before its `stop`, the
# keep-awake self-expires (default 4h) instead of leaking forever.
#
# State lives OUTSIDE the repo (koji global state dir), keyed per project so
# concurrent projects don't collide. Env overrides:
#   KOJI_STATE_DIR            — state directory (default ~/.config/koji)
#   KOJI_KEEPAWAKE_BACKSTOP   — backstop seconds (default 14400 = 4h)

set -euo pipefail

BACKSTOP="${KOJI_KEEPAWAKE_BACKSTOP:-14400}"
STATE_DIR="${KOJI_STATE_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/koji}"

# Stable per-project key: git toplevel if available, else cwd.
PROJ="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P 2>/dev/null || echo global)"
KEY="$(printf '%s' "$PROJ" | cksum | cut -d' ' -f1)"
STATE="$STATE_DIR/keepawake-$KEY.state"   # line 1: refcount, line 2: owned pid (empty if none)

mkdir -p "$STATE_DIR" 2>/dev/null || true

COUNT=0
PID=""
_read_state() {
  COUNT=0; PID=""
  if [ -f "$STATE" ]; then
    COUNT=$(sed -n '1p' "$STATE" 2>/dev/null || echo 0)
    PID=$(sed -n '2p' "$STATE" 2>/dev/null || echo "")
    case "$COUNT" in ''|*[!0-9]*) COUNT=0 ;; esac
  fi
}
_write_state() { printf '%s\n%s\n' "$1" "$2" > "$STATE"; }

# Is pid $1 alive? (false for empty)
_alive() { [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null; }

# Spawn the platform keep-awake in the background; sets SPAWNED_PID (empty if
# unsupported / tool missing). Runs in the current shell so $! is reliable.
SPAWNED_PID=""
_spawn() {
  SPAWNED_PID=""
  case "$(uname -s)" in
    Darwin)
      command -v caffeinate >/dev/null 2>&1 || return 0
      caffeinate -i -t "$BACKSTOP" >/dev/null 2>&1 &
      SPAWNED_PID=$!
      ;;
    Linux)
      command -v systemd-inhibit >/dev/null 2>&1 || return 0
      systemd-inhibit --what=idle:sleep --who=koji \
        --why="koji autonomous session" sleep "$BACKSTOP" >/dev/null 2>&1 &
      SPAWNED_PID=$!
      ;;
  esac
}

# Is some keep-awake process (ours or external) already preventing idle sleep?
# `pgrep -x caffeinate` is the real gate on Darwin (the user-proposed
# `pmset | grep PreventUserIdleSystemSleep` always matches the summary line, so
# it adds nothing). On Linux this is a no-op and the refcount governs nesting.
_external_awake() { pgrep -x caffeinate >/dev/null 2>&1; }

case "${1:-}" in
  start)
    _read_state
    # Self-heal: if we recorded a pid but it has died (backstop fired, or it was
    # killed out from under us), the prior run is over — reset the refcount.
    if [ "$COUNT" -gt 0 ] && [ -n "$PID" ] && ! _alive "$PID"; then
      COUNT=0; PID=""
    fi
    if [ "$COUNT" -eq 0 ]; then
      if _external_awake; then
        PID=""   # someone else owns it — never claim or kill it
        echo "keep-awake: already active (not koji-owned) — leaving it alone"
      else
        _spawn
        PID="$SPAWNED_PID"
        if [ -n "$PID" ]; then
          echo "keep-awake: started (pid $PID, ${BACKSTOP}s backstop)"
        else
          echo "keep-awake: no sleep-prevention tool on this platform — continuing without it"
        fi
      fi
    else
      echo "keep-awake: already held (refcount $COUNT) — reusing"
    fi
    _write_state "$((COUNT + 1))" "$PID"
    ;;

  stop)
    _read_state
    NEW=$((COUNT - 1))
    [ "$NEW" -lt 0 ] && NEW=0
    if [ "$NEW" -eq 0 ]; then
      if _alive "$PID"; then
        kill "$PID" 2>/dev/null || true
        echo "keep-awake: stopped (pid $PID)"
      else
        echo "keep-awake: released"
      fi
      rm -f "$STATE" 2>/dev/null || true
    else
      _write_state "$NEW" "$PID"
      echo "keep-awake: released one hold (refcount now $NEW)"
    fi
    ;;

  status)
    _read_state
    if [ "$COUNT" -gt 0 ] && _alive "$PID"; then
      echo "keep-awake: koji-owned active (pid $PID, refcount $COUNT)"
      exit 0
    elif _external_awake; then
      echo "keep-awake: active (not koji-owned)"
      exit 0
    else
      echo "keep-awake: inactive"
      exit 1
    fi
    ;;

  *)
    echo "Usage: koji-keepawake {start|stop|status}" >&2
    exit 2
    ;;
esac
