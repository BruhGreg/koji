#!/usr/bin/env bash
# koji-codex-classify — classify a completed `codex exec` result into one state.
#
# Closes the quota→false-pass hole: the duet skills used to regex a `[...]` from
# codex stdout and, finding none, write `[]` — which downstream reads as "codex
# reviewed, zero findings → PASS". A depleted 5-hour quota returns a rate-limit
# message (no findings JSON), so that path silently banks a clean review. This
# helper makes a quota reply its OWN state, distinct from empty findings.
#
#   koji-codex-classify <raw> <err> <exit> [--json-out <file>] [--prose]
#
# Prints ONE state token to stdout: OK | QUOTA | TIMEOUT | ERROR | EMPTY
#   OK      — a valid findings JSON array (a list of objects; may be `[]`); exit 0.
#             Written to --json-out. A valid array means codex actually reviewed,
#             even if a finding's TEXT mentions "rate limit" (precedence guard
#             against false-QUOTA that would waste a back-off).
#   QUOTA   — no valid array AND a quota/rate-limit marker present. Stderr always
#             counts; at exit 0 stdout counts only when it is shaped like a
#             refusal (_is_refusal). Caller backs off + retries; never a PASS.
#   TIMEOUT — no array, no markers, exit 124.
#   ERROR   — no array, no markers, non-zero exit.
#   EMPTY   — no array, no markers, exit 0 (genuine drift: prose reply). Writes `[]`.
#
# --prose mode (flags may appear in any order after the three positional files):
#   /duet-plan's codex leg answers with a PROSE critique that ends in a
#   `VERDICT: AGREE|PARTIAL|DISAGREE` line — never a findings array. Fed such a
#   reply, the default mode finds no array. It used to substring-scan stdout
#   for 'quota' / 'rate limit' / '429' and label a healthy critique that merely
#   DISCUSSES quota handling QUOTA — a false back-off (observed for real:
#   tests/fixtures/codex-prose-review.txt). The refusal-shape rule now reads
#   such a reply as EMPTY in both modes; --prose still matters because it
#   reads the VERDICT line as a real answer: OK iff exit 0 AND koji-duet-verdict
#   parses a real verdict token (AGREE/PARTIAL/DISAGREE, not UNKNOWN), checked
#   BEFORE any quota scan. Anything else falls through to exactly the default
#   QUOTA / TIMEOUT / ERROR / EMPTY logic above. No array is extracted and
#   --json-out is ignored (a prose reply has no findings JSON to write).
set -euo pipefail

# A quota refusal at exit 0 has a SHAPE: its first non-blank line opens with
# "Error:", "Error [429]", "Error (" or "You've hit your usage limit". An answer
# that merely discusses rate limits or a 429 does not — that is a malformed
# reply (the call site retries it), never a five-hour back-off. This is the ONE
# definition: koji-outside-exec asks it through `--refusal <reply-file>`.
_is_refusal() {
  awk 'NF{print; exit}' "$1" 2>/dev/null \
    | grep -iE "^[[:space:]]*(error[[:space:]]*(:|\[|\()|you('|’)?(ve| have) (hit|reached|exceeded) your (usage|rate))" >/dev/null
}
if [ "${1:-}" = "--refusal" ]; then
  _is_refusal "${2:?Usage: koji-codex-classify --refusal <reply-file>}"
  exit $?
fi

RAW="${1:?Usage: koji-codex-classify <raw> <err> <exit> [--json-out <file>] [--prose] | --refusal <reply-file>}"
ERR="${2:?}"
EXITF="${3:?}"
shift 3
JSON_OUT=""
PROSE=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --json-out) JSON_OUT="${2:?--json-out needs a path}"; shift 2 ;;
    --prose)    PROSE=1; shift ;;
    *)          shift ;;
  esac
done

EXIT="$(cat "$EXITF" 2>/dev/null || echo 1)"

if [ "$PROSE" = "1" ]; then
  # Prose reply: there is no findings array, so --json-out has nothing to write.
  JSON_OUT=""
  # 1'. A parsed verdict token on a clean exit == the reviewer actually answered.
  #     Checked BEFORE the quota scan so a critique that merely mentions quota
  #     can never be mistaken for a quota reply.
  if [ "$EXIT" = "0" ]; then
    PROSE_VERDICT="$(bash "$(dirname "$0")/koji-duet-verdict" "$RAW" 2>/dev/null || echo UNKNOWN)"
    case "$PROSE_VERDICT" in
      AGREE|PARTIAL|DISAGREE) echo OK; exit 0 ;;
    esac
  fi
else
  # 1. Try to extract a valid JSON array from raw stdout (same shape the reviewers
  #    are told to emit). A valid array == codex responded with a review. Every
  #    item must be an object (`[]` is valid): a findings, cross or consult reply
  #    is a list of objects, and a refusal like "Error [429]: You have hit your
  #    usage limit." yields `[429]` — which must fall through to the quota scan,
  #    not read as a clean review.
  ARRAY="$(python3 -c "
import re, sys
raw = open('$RAW').read() if __import__('os').path.exists('$RAW') else ''
import json
m = re.search(r'\[.*\]', raw, re.DOTALL)
if m:
    try:
        v = json.loads(m.group(0))
    except Exception:
        sys.exit(1)
    if isinstance(v, list) and all(isinstance(e, dict) for e in v):
        sys.stdout.write(m.group(0)); sys.exit(0)
sys.exit(1)
" 2>/dev/null)" && HAVE_ARRAY=1 || HAVE_ARRAY=0

  if [ "$HAVE_ARRAY" = "1" ] && [ "$EXIT" = "0" ]; then
    [ -n "$JSON_OUT" ] && printf '%s' "$ARRAY" > "$JSON_OUT"
    echo OK; exit 0
  fi
fi

# 2. No usable array — is this a quota/rate-limit reply? Scan stdout+stderr,
#    except an exit-0 reply's stdout that is not shaped like a refusal: an
#    answer that discusses rate limits is a malformed reply. Stderr always counts.
if [ "$EXIT" = "0" ] && ! _is_refusal "$RAW"; then
  HAYSTACK="$( { cat "$ERR" 2>/dev/null || true; } | tr 'A-Z' 'a-z' )"
else
  HAYSTACK="$( { cat "$RAW" "$ERR" 2>/dev/null || true; } | tr 'A-Z' 'a-z' )"
fi
# Phrases, not identifier fragments: this scan also reads review TEXT, so a
# bare `ratelimit` would flag every review of a RateLimiter as QUOTA. agy's own
# wording (`exhausted your capacity`, `rate-limit`) is normalized at its source:
# koji-agy-exec prints `agy quota exhausted: …`, which the 'quota' marker reads.
for m in 'usage limit' 'rate limit' 'rate_limit' 'too many requests' \
         'quota' 'no tokens' 'insufficient_quota' 'resource_exhausted'; do
  case "$HAYSTACK" in *"$m"*) echo QUOTA; exit 0 ;; esac
done
# 429 only as a standalone number: a byte count such as 164290, or a line
# number, is not an HTTP 429. A bash regex, not a pipe into `grep -q`: under
# pipefail grep -q exits at the first match, SIGPIPEs a producer with more than
# ~64 KB left to write, and the check fails.
RE_429='(^|[^0-9])429([^0-9]|$)'
if [[ "$HAYSTACK" =~ $RE_429 ]]; then echo QUOTA; exit 0; fi

# 3. Not quota — timeout / error / genuine-empty.
if [ "$EXIT" = "124" ]; then echo TIMEOUT; exit 0; fi
if [ "$EXIT" != "0" ]; then echo ERROR; exit 0; fi
[ -n "$JSON_OUT" ] && printf '[]' > "$JSON_OUT"
echo EMPTY
