#!/usr/bin/env bash
# koji-duet-verdict — extract the consensus verdict token from a duet round file.
#
# Reads the last `VERDICT: <TOKEN> ...` line of <file> and echoes the token,
# uppercased: AGREE / PARTIAL / DISAGREE (or UNKNOWN when no verdict line).
# Used by /duet-plan's consensus check (and any duet flow writing VERDICT lines).
#
# Lives in bin/ on purpose: the token parse needs an awk field ref ($1), and the
# skill renderer silently strips literal $0/$N field refs from inline SKILL awk
# — which blanked the token so consensus was NEVER detected and every duet-plan
# ran to the round limit before escalating. Helpers run via bash directly and
# are immune.
#
#   koji-duet-verdict <file>   — echo the verdict token (uppercased)
set -euo pipefail

FILE="${1:?Usage: koji-duet-verdict <file>}"

# grep isolates VERDICT lines (any case), allowing markdown before the word and
# around the colon — `**VERDICT: AGREE**`, `> VERDICT:`, `- **VERDICT:** AGREE`,
# and inline code (`VERDICT: AGREE` in backticks, the form the prompt templates
# show) — because reviewers decorate the line and an unread vote costs a call.
# Strip everything up to the first colon (portable; grep already case-folded),
# then leading emphasis, take the first token, uppercase it, cut a trailing
# ":reason" BEFORE stripping trailing emphasis (`PARTIAL**: x` → `PARTIAL`).
# Exact tokens only: `AGREEMENT IS NOT POSSIBLE` is not AGREE. Anything but
# AGREE / PARTIAL / DISAGREE — or no verdict line — is UNKNOWN.
REST=$(
  grep -iE '^[[:space:]*_>#`-]*VERDICT[[:space:]*_`]*:' "$FILE" 2>/dev/null \
    | tail -1 \
    | sed -E 's/^[^:]*:[[:space:]*_`]*//' \
    || true
)
# The token is a vote only when nothing but closing decoration or a REASON
# follows it: `PARTIAL: needs X`, `DISAGREE — skips X`, `AGREE (nits)`.
# `AGREE is not possible until X` and `**VERDICT: AGREE** would be my vote`
# are prose about a vote — UNKNOWN, so they can never auto-lock a plan.
verdict=UNKNOWN
if printf '%s\n' "$REST" | grep -qiE '^(AGREE|PARTIAL|DISAGREE)[*_`~.,;!]*[[:space:]]*($|:|\(|—|–|-([[:space:]]|$))'; then
  verdict=$(printf '%s' "$REST" | awk '{print toupper($1)}' | sed -E 's/(:|\(|—|–).*$//; s/[*_`~.,;!-]+$//')
fi
case "$verdict" in
  AGREE|PARTIAL|DISAGREE) printf '%s\n' "$verdict" ;;
  *)                      printf 'UNKNOWN\n' ;;
esac
