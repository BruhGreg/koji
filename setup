#!/usr/bin/env bash
# koji setup — install koji skills into Claude Code
set -euo pipefail

KOJI_DIR="$(cd "$(dirname "$0")" && pwd)"
SKILLS_DIR="$(dirname "$KOJI_DIR")"
STATE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/koji"

is_windows() {
  case "${OSTYPE:-}${OS:-}" in
    msys*|cygwin*|mingw*|*Windows_NT*) return 0 ;;
  esac
  return 1
}

echo "=== koji setup ==="
echo "Source: $KOJI_DIR"
echo "Skills: $SKILLS_DIR"
is_windows && echo "Platform: Windows (using directory junctions)"

# --- Create state directory ---
mkdir -p "$STATE_DIR"
echo "State dir: $STATE_DIR"

# --- Make scripts executable ---
chmod +x "$KOJI_DIR/bin/"*
echo "Scripts: chmod +x"

# --- Link skills ---
# Removes an existing symlink, junction, or directory copy at $1 without
# following into the target (important for junctions/symlinks).
remove_existing() {
  local path="$1"
  [ -e "$path" ] || [ -L "$path" ] || return 0
  if [ -L "$path" ]; then
    rm -f "$path"
    return
  fi
  if is_windows && [ -d "$path" ]; then
    # rmdir (no /S) unlinks a junction or removes an empty dir;
    # it never recurses into a junction target.
    if cmd //c rmdir "$(cygpath -w "$path")" >/dev/null 2>&1; then
      return
    fi
  fi
  rm -rf "$path"
}

create_link() {
  local name="$1" target="$2"
  local link_path="$SKILLS_DIR/$name"
  local target_abs="$KOJI_DIR/$target"

  remove_existing "$link_path"

  if is_windows; then
    cmd //c mklink //J "$(cygpath -w "$link_path")" "$(cygpath -w "$target_abs")" >/dev/null
  else
    ln -s "koji/$target" "$link_path"
  fi
  echo "  $name -> koji/$target"
}

echo "Links:"
create_link "wrap" "wrap"
create_link "take-note" "take-note"
create_link "kick-off" "kick-off"
create_link "koji-init" "koji-init"
create_link "inspect-doc-drift" "inspect-doc-drift"
create_link "duet-plan" "duet-plan"
create_link "duet-impl" "duet-impl"
create_link "duet-review" "duet-review"
create_link "triangulate" "triangulate"
create_link "plan-triangulate-review" "plan-triangulate-review"

# --- Link reviewer agents ---
# The duet skills dispatch Claude reviewers as `koji-reviewer-<effort>` so the
# reviewer runs at the effort the user picked (an agent's effort lives in its
# definition file's frontmatter, not on the Agent call). ~/.claude/agents does
# not exist on a fresh install.
AGENTS_DIR="$(dirname "$SKILLS_DIR")/agents"
mkdir -p "$AGENTS_DIR"
echo "Agents:"
for effort in high xhigh max; do
  name="koji-reviewer-$effort"
  link_path="$AGENTS_DIR/$name.md"
  target_abs="$KOJI_DIR/agents/$name.md"
  remove_existing "$link_path"
  if is_windows; then
    cp "$target_abs" "$link_path"     # file junctions don't exist; a copy is refreshed by re-running setup
  else
    ln -s "../skills/koji/agents/$name.md" "$link_path"
  fi
  echo "  $name -> koji/agents/$name.md"
done

# --- Verify ---
echo ""
echo "Installed skills:"
for skill in wrap take-note kick-off koji-init inspect-doc-drift duet-plan duet-impl duet-review triangulate plan-triangulate-review; do
  if [ -f "$SKILLS_DIR/$skill/SKILL.md" ]; then
    echo "  /$skill  OK"
  else
    echo "  /$skill  FAILED" >&2
  fi
done

echo ""
echo "Installed agents:"
AGENTS_FAILED=0
for effort in high xhigh max; do
  f="$AGENTS_DIR/koji-reviewer-$effort.md"
  if [ -f "$f" ] && grep -q "^effort: $effort\$" "$f"; then
    echo "  koji-reviewer-$effort  OK"
  else
    echo "  koji-reviewer-$effort  FAILED (missing, dangling, or wrong effort)" >&2
    AGENTS_FAILED=1
  fi
done
[ "$AGENTS_FAILED" = 0 ] || { echo "  AGENT INSTALL FAILED — the duet skills would fall back to inherited effort." >&2; exit 1; }
echo "  (a running Claude Code session must restart to see new agent types)"

echo ""
echo "Self-check (load-bearing skill markers):"
"$KOJI_DIR/bin/koji-selfcheck" || { echo "  SELF-CHECK FAILED — a skill's load-bearing markers are missing (see above)." >&2; exit 1; }

echo ""
echo "koji is ready. Run /koji-init in any project to get started."
